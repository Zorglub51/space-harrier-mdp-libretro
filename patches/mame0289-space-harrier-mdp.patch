+// Le DAC du Mark V emule par M2 est lineaire : les trois bits d'un canal valent
+// 0, 32, ... 224. Le VDP Mega Drive de MAME emploie volontairement la courbe
+// non lineaire mesuree sur la console reelle, ce qui surexposait toutes les ROM MDP
+// (par exemple 0x6 devenait 206 au lieu de 192 et 0x7 devenait 255 au lieu de 224).
+// Les captures officielles du Mega Drive Mini 2 confirment la rampe lineaire.
+static rgb_t mdp_palette_pen(u16 data)
+{
+	const int mode = (data >> 9) & 3;
+	const int r = (data >> 0) & 7;
+	const int g = (data >> 3) & 7;
+	const int b = (data >> 6) & 7;
+	auto level = [mode](int c)
+	{
+		if (mode == 1) return c * 16;                 // ombre
+		if (mode == 2) return std::min(255, 128 + c * 16); // surbrillance
+		return c * 32;                                // couleur normale
+	};
+	return rgb_t(level(r), level(g), level(b));
+}
