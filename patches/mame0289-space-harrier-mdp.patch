+void sega315_5313_device::mdp_scaler_line(int scanline)
+{
+	if (!m_mdp_scaler || scanline < 0 || scanline >= 240)
+		return;
+
+	// SH1 place sa table de 224 entrees a D1E000, tandis que SH2 la place a
+	// D10000. Les deux zones appartiennent a la meme RAM MDP et l'autre contient
+	// donc generalement des pixels, pas une table vide. Reconnaitre la table par
+	// ses ordonnees source : une vraie entree vise l'atelier du plan A (224..511).
+	// Le comptage sur la trame entiere evite qu'un mot de pixels fortuitement
+	// plausible fasse basculer une seule ligne vers la mauvaise zone.
+	auto table_score = [](const u16 *table)
+	{
+		int score = 0;
+		for (int y = 0; y < 224; y++)
+		{
+			const u16 *const line = table + y * 8;
+			const s32 fy = s32((u32(line[6]) << 16) | line[7]);
+			const s32 iy = fy >> 12;
+			if (fy && iy >= 224 && iy < 512)
+				score++;
+		}
+		return score;
+	};
+	const u16 *const sh2_table = m_mdp_scaler;
+	const u16 *const sh1_table = m_mdp_scaler + 0x7000;
+	const bool sh2_layout = table_score(sh2_table) > table_score(sh1_table);
+	m_mdp_sh2_layout = sh2_layout;
+	const u16 *const table = sh2_layout ? sh2_table : sh1_table;
+	int table_line = scanline;
+	if (sh2_layout)
+	{
+		// Les coordonnees verticales du Mark V ont une amorce de 53 lignes. Le
+		// plafond/ciel reste a pas unitaire ; les 48 lignes de perspective restantes
+		// sont ensuite etirees jusqu'au bas de l'ecran. Les traiter comme 224 lignes
+		// Mega Drive plaçait l'horizon beaucoup trop bas.
+		constexpr int top_bias = 53;
+		int perspective = 112;
+		while (perspective < 224 && s16(table[perspective * 8]) == 0x1000)
+			perspective++;
+		const int horizon = std::max(0, perspective - top_bias);
+		if (scanline < horizon)
+			table_line = scanline + top_bias;
+		else if (perspective < 224)
+			table_line = perspective + ((scanline - horizon) * (224 - perspective)) / (224 - horizon);
+	}
+	const u16 *const e = table + table_line * 8;
+	const s32 srcy_fx = s32((u32(e[6]) << 16) | e[7]);
+	if (!srcy_fx)
+		return;                                     // ligne inactive
+	const s32 srcy = srcy_fx >> 12;
+	if (srcy < 224 || srcy >= 512)
+		return;                                     // hors de l'atelier
+
+	const u32 plane_a = MEGADRIVE_REG02_PATTERN_ADDR_A << 13;
+	const u32 plane_b = MEGADRIVE_REG04_PATTERN_ADDR_B << 13;
+	const int width = (get_hres() >= 2) ? 320 : 256;
+	if (sh2_layout && plane_a != plane_b)
+		return;
+	if (sh2_layout && table_line < 112 && srcy >= 336)
+	{
+		// Les plafonds SH2 proviennent de Y < 336. Les lignes 336..431 de cette
+		// amorce sont une copie hors ecran des montagnes des stages ouverts.
+		for (int x = 0; x < width; x++)
+			m_video_renderline[x] = 0;
+		return;
+	}
+	if (sh2_layout && srcy >= 432)
+	{
+		for (int x = 0; x < width; x++)
+			m_video_renderline[x] = 0;
+		return;
+	}
+	const s32 step = s16(e[0]);
+	s32 sx = s32((u32(e[4]) << 16) | e[5]);
+
+	for (int x = 0; x < width; x++, sx += step)
+	{
+		const s32 source_x = sx >> 12;
+		// +4 autorise le rebouclage horizontal du decor 3D. Il reste cependant a
+		// 0x1000 lorsque le mode attract revient au titre. La derniere ligne retrouve
+		// alors la transformation identite exacte (pas 1.0, X=0, Y=223) : c'est le
+		// discriminateur stable du titre, y compris apres plusieurs demos.
+		const u16 *const tail = table + 223 * 8;
+		const u32 tail_x = (u32(tail[4]) << 16) | tail[5];
+		const u32 tail_y = (u32(tail[6]) << 16) | tail[7];
+		const bool title_transform = tail[0] == 0x1000 && tail_x == 0 && tail_y == 0x000df000;
+		const bool wrap_x = e[2] && !title_transform;
+		if (!wrap_x && (source_x < 0 || source_x >= 512))
+			continue;
+		const u32 px = wrap_x ? (source_x & (sh2_layout ? 0xff : 0x1ff)) : source_x;
+		const u32 py = srcy;
+
+		const u16 ent = m_vram[((plane_a >> 1) + (py >> 3) * 64 + (px >> 3)) & 0x7fff];
+		int tx = px & 7;
+		int ty = py & 7;
+		if (BIT(ent, 11)) tx ^= 7;
+		if (BIT(ent, 12)) ty ^= 7;
+		const u16 row = m_vram[((ent & 0x07ff) * 16 + ty * 2 + (tx >> 2)) & 0x7fff];
+		const int c = (row >> (12 - (tx & 3) * 4)) & 0x0f;
+		if (c)
+			m_video_renderline[x] = c | (((ent >> 13) & 3) << 4);
+	}
+}
