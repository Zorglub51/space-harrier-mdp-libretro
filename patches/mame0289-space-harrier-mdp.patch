+		{
+			static FILE *fp = fopen(getenv("MDP_NAMEOUT") ? getenv("MDP_NAMEOUT") : "/tmp/nt.txt", "w");
+			static int cpt = 0;
+			if (fp && cpt < 60)
+			{
+				// on ne retient qu'un echantillon : les ecritures de contenu, et une
+				// ligne recapitulative par rafale d'effacement
+				static u16 dernier = 0xffff; static int rafale = 0;
+				const bool vide = ((data & 0x7ff) == 0);
+				if (!vide)
+				{
+					if (rafale) { fprintf(fp, "   ... %d effacements %04X\n", rafale, dernier); rafale = 0; }
+					fprintf(fp, "trame %4d  PC=%06X  VRAM %04X <- %04X\n",
+							int(screen().frame_number()), u32(m_cpu68k->pcbase()) & 0xffffff,
+							m_vdp_address, data);
+					cpt++;
+				}
+				else if (data == dernier) rafale++;
+				else
+				{
+					if (rafale) { fprintf(fp, "   ... %d effacements %04X\n", rafale, dernier); }
+					fprintf(fp, "trame %4d  PC=%06X  effacement %04X a partir de %04X\n",
+							int(screen().frame_number()), u32(m_cpu68k->pcbase()) & 0xffffff,
+							data, m_vdp_address);
