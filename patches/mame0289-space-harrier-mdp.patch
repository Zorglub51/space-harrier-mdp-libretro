+// ---------------------------------------------------------------------------
+// Zoomeur materiel MDP : une entree de 16 octets par ligne d'ecran, a 0xD1E000.
+//     +0  pas horizontal, virgule fixe 12 bits (0x1000 = 1.0)
+//     +8  abscisse source de depart, 20.12 signe
+//     +C  ordonnee source, 20.12  (0 = ligne inactive)
+// La source est l'espace pixel du plan A (64x64 tuiles = 512x512), dont les lignes
+// 224+ sont hors de la fenetre visible et servent d'atelier.
+//
+// On ecrit dans m_video_renderline, la couche de fond, et non sur l'image finale :
+// les sprites sont composes apres, donc ils repassent correctement par-dessus. Poser
+// le resultat en fin de rendu faisait passer nuages et montagnes devant les sprites.
+// ---------------------------------------------------------------------------
+// Moyenne de la trame courante et de la precedente. N'a d'effet que sur une machine
+// MDP (m_mdp_scaler resolu), pour ne rien changer aux autres pilotes Mega Drive.
+void sega315_5313_device::mdp_blend_frame(bitmap_rgb32 &bitmap, const rectangle &cliprect)
+{
+	if (!m_mdp_scaler)
+		return;
+
+	const int w = cliprect.width(), h = cliprect.height();
+	if (!m_mdp_prev_frame || m_mdp_prev_w != w || m_mdp_prev_h != h)
+	{
+		m_mdp_prev_frame = std::make_unique<u32[]>(size_t(w) * h);
+		m_mdp_prev_w = w;
+		m_mdp_prev_h = h;
+		std::fill_n(m_mdp_prev_frame.get(), size_t(w) * h, 0);
+	}
+
+	for (int y = 0; y < h; y++)
+	{
+		const int sy = cliprect.min_y + y;
+		u32 *const line = &bitmap.pix(cliprect.min_y + y, cliprect.min_x);
+		u32 *const prev = &m_mdp_prev_frame[size_t(y) * w];
+		const bool blend_bg = sy >= 0 && sy < 512 &&
+			m_mdp_bg_valid[sy] && m_mdp_prev_bg_valid[sy];
+		const u32 cur_bg = blend_bg ? m_mdp_bg_rgb[sy] : 0;
+		const u32 old_bg = blend_bg ? m_mdp_prev_bg_rgb[sy] : 0;
+		for (int x = 0; x < w; x++)
+		{
+			const u32 cur = line[x], old = prev[x];
+			prev[x] = cur;
+
+			// Le jeu peut alterner deux couleurs de fond eloignees (62 niveaux sur le
+			// canal bleu au stage 1). L'ancien seuil RGB laissait donc scintiller ces
+			// lignes. Ne moyenner que les pixels qui etaient le fond aux deux trames
+			// supprime le seuil sans creer de trainee sur les sprites en mouvement.
+			if (blend_bg && cur == cur_bg && old == old_bg)
+			{
+				// Une coupure franche (noir -> decor, changement de stage) n'est pas du
+				// tramage. Le seuil, desormais limite au seul fond, peut etre assez large
+				// pour la paire du stage 1 sans jamais melanger un sprite en mouvement.
+				const int dr = std::abs(int((cur >> 16) & 0xff) - int((old >> 16) & 0xff));
+				const int dg = std::abs(int((cur >>  8) & 0xff) - int((old >>  8) & 0xff));
+				const int db = std::abs(int( cur        & 0xff) - int( old        & 0xff));
+				if (dr <= 96 && dg <= 96 && db <= 96)
+					line[x] = (((cur ^ old) & 0xfefefe) >> 1) + (cur & old);
+			}
+		}
+		if (sy >= 0 && sy < 512)
+		{
+			m_mdp_prev_bg_rgb[sy] = m_mdp_bg_rgb[sy];
+			m_mdp_prev_bg_valid[sy] = m_mdp_bg_valid[sy];
+		}
+	}
+}
