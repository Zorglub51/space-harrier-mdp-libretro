+				if (m_markvi_ready[bank] && (source & 0xffffff) == m_markvi_source[bank])
+				{
+					const u16 *native = reinterpret_cast<const u16 *>(m_space68k->get_read_ptr(source & 0xffffff));
+					bool same = native != nullptr;
+					for (unsigned i = 0; same && i < 0x140; ++i)
+						same = (native[i] & mask(i)) == m_markvi_sat[bank][i];
+					if (!same)
+						continue; // The game cleared/replaced this producer bank.
+					std::copy_n(m_markvi_ram[bank], 0x10000, m_markvi_ram[2]);
+					std::copy_n(m_markvi_sat[bank], 0x140, m_markvi_sat[2]);
+					std::copy_n(m_markvi_tail[bank], 0x141, m_markvi_tail[2]);
+					m_markvi_source[2] = bank ? 0xff140c : 0xff118a;
+					m_markvi_ready[2] = true;
+					break;
+				}
+		sh2_markvi_rebuild();
+	}
+	else if (was_active && count && count <= 0x140 && !(count & 3) &&
+		(source & 0xffffff) == m_markvi_source[2] &&
+		count == u32(m_markvi_tail[2][0x140]) * 4 &&
+		address == sat_base + 0x280 - count * 2)
+	{
+		// SH2 0ADF10/0AE02C uploads the overflow partition on the following
+		// refresh. It belongs to the same completed constructor, whose host
+		// list already includes these pieces before quotas. Validate against
+		// the displayed snapshot: the producer may already be rebuilding.
+		const u16 *native = reinterpret_cast<const u16 *>(m_space68k->get_read_ptr(source & 0xffffff));
+		bool same = native != nullptr;
+		for (unsigned i = 0; same && i < count; ++i)
+			same = (native[i] & mask(i)) == m_markvi_tail[2][i];
+		for (unsigned i = 0; same && i < 0x140 - count; ++i)
+			same = (mdp_vram_word((sat_base >> 1) + i) & mask(i)) == m_markvi_sat[2][i];
+		m_markvi_ready[2] = same;
+	}
+}
+
+void sega315_5313_device::sh2_markvi_capture()
+{
+	if (!m_sh2_text_compat)
+		return;
+	const u16 *ram = reinterpret_cast<const u16 *>(m_space68k->get_read_ptr(0xfe0000));
+	if (!ram)
+		return;
+	const unsigned bank = ram[(0xff387c - 0xfe0000) / 2] & 1;
+	std::copy_n(ram, 0x10000, m_markvi_ram[bank]);
+	m_markvi_source[bank] = bank ? 0xff3080 :
+		((u32(ram[(0xff0e00 - 0xfe0000) / 2]) << 16) | ram[(0xff0e02 - 0xfe0000) / 2]) & 0xffffff;
+	m_markvi_ready[bank] = false;
+	m_markvi_build_bank = bank;
+}
+
+void sega315_5313_device::sh2_markvi_finalize()
+{
+	if (m_markvi_build_bank < 0)
+		return;
+	const unsigned bank = unsigned(m_markvi_build_bank);
+	m_markvi_build_bank = -1;
+	const u32 source = m_markvi_source[bank];
+	if ((source & 1) || source < 0xfe0000 || source > 0xfffd80)
+		return;
+	const u16 *native = reinterpret_cast<const u16 *>(m_space68k->get_read_ptr(source));
+	if (!native)
+		return;
+	for (unsigned i = 0; i < 0x140; ++i)
+		m_markvi_sat[bank][i] = native[i] & ((i & 3) == 1 ? 0xff00 : 0xffff);
+	const u32 tail_source = bank ? 0xff140c : 0xff118a;
+	const u16 *tail = reinterpret_cast<const u16 *>(m_space68k->get_read_ptr(tail_source));
+	if (!tail)
+		return;
+	for (unsigned i = 0; i < 0x140; ++i)
+		m_markvi_tail[bank][i] = tail[i] & ((i & 3) == 1 ? 0xff00 : 0xffff);
+	m_markvi_tail[bank][0x140] = m_space68k->read_word(bank ? 0xff168c : 0xff140a);
+	m_markvi_ready[bank] = true;
+}
+
+void sega315_5313_device::sh2_markvi_rebuild()
+{
+    m_markvi_smooth_valid = false;
+	m_markvi_sprites.clear();
+	if (!m_markvi_ready[2] || !m_space68k)
+		return;
+	const auto read = [this](u32 address) -> u16
+	{
+		return address >= 0xfe0000 ? m_markvi_ram[2][(address - 0xfe0000) >> 1] :
+			(address < 0x400000 ? m_space68k->read_word(address) : 0);
+	};
+	if (!sh2_markvi::build(read, m_markvi_sprites))
+	{
+		m_markvi_ready[2] = false;
+		m_markvi_sprites.clear();
+	}
+}
+
+// Original M2 C1E24: select the linked SAT in forward order, then draw it in
+// reverse order. Limits count source columns, including transparent/offscreen
+// cells, regardless of zoom. The final selected sprite uses the remaining
+// column count. SAT entries are read from VRAM rather than the MD VDP cache.
+void sega315_5313_device::mdp_render_spriteline(int scanline)
+{
+	std::fill_n(m_sprite_renderline.get(), 1024, 0);
+	const int viewport = (m_regs[12] & 0x81) == 0x81 ? 320 : 256;
+	const int sprite_limit = viewport >> 4;
+	const u32 sat_base = (m_regs[5] & 0x7f) << 8; // word address
+	const bool zoom = BIT(m_regs[36], 7);
+	const u32 zoom_base = (m_regs[36] & 0x1f) << 11;
+	bool visited[128]{};
+	u8 selected[20];
+	int count = 0, columns = viewport >> 3;
+	u32 index = 0;
+
+	do
+	{
+		visited[index] = true;
+		const u32 sat = sat_base | (index << 2);
+		const u16 size = mdp_vram_word(sat + 1);
+		const u16 xword = mdp_vram_word(sat + 3);
+		const int height = ((size >> 8) & 3) + 1;
+		const int width = ((size >> 10) & 3) + 1;
+		const u32 ystep = zoom ? ((mdp_vram_word(zoom_base + (xword >> 9) * 8 + 3) & 0x7fff) >> 6) : 64;
+		const u32 row = (scanline + 128 - mdp_vram_word(sat)) & 0x3ff;
+		if (row < (height * ystep) >> 3)
+		{
+			if (!(xword & 0x1ff))
+				break;
+			selected[count++] = u8(index);
+			if (count == sprite_limit || columns <= width)
+				break;
+			columns -= width;
+		}
+		index = size & 0x7f;
+	}
+	while (!visited[index]);
+
+	static constexpr u8 shrink_map[8][8] = {
+		{ 0, 0, 0, 0, 0, 0, 0, 0 },
+		{ 4, 0, 0, 0, 0, 0, 0, 0 },
+		{ 2, 6, 0, 0, 0, 0, 0, 0 },
+		{ 1, 4, 6, 0, 0, 0, 0, 0 },
+		{ 1, 3, 5, 7, 0, 0, 0, 0 },
+		{ 0, 2, 4, 5, 7, 0, 0, 0 },
+		{ 0, 2, 3, 4, 6, 7, 0, 0 },
+		{ 0, 1, 2, 4, 5, 6, 7, 0 }
+	};
+	while (count)
+	{
+		const u32 sat = sat_base | (u32(selected[--count]) << 2);
+		const u16 size = mdp_vram_word(sat + 1);
+		const u16 xword = mdp_vram_word(sat + 3);
+		const int height = ((size >> 8) & 3) + 1;
+		const int width = ((size >> 10) & 3) + 1;
+		const u32 transform = zoom_base + (xword >> 9) * 8;
+		const u32 ystep = zoom ? ((mdp_vram_word(transform + 3) & 0x7fff) >> 6) : 64;
+		const int xstep = zoom ? (std::min<u32>(mdp_vram_word(transform) & 0x7fff, 0x1000) >> 6) : 64;
+		const u32 delta = (scanline + 128 - mdp_vram_word(sat)) & 0x3ff;
+		const u32 source_y = zoom ? ((delta * 64) / ystep) : delta;
+		u32 attr = mdp_vram_word(sat + 2);
+		const u32 tile_y = BIT(attr, 12) ? height - 1 - (source_y >> 3) : (source_y >> 3);
+		attr += tile_y;
+		const bool reverse = BIT(attr, 11);
+		int xacc = ((xword & 0x1ff) - 128) * 8;
+		if (reverse)
+			xacc += xstep * width;
+		const int cells = std::min(columns, width);
+
+		for (int cell = 0; cell < cells; ++cell, attr += height)
+		{
+			int start, end;
+			if (!reverse)
+			{
+				start = xacc >> 3;
+				xacc += xstep;
+				end = xacc >> 3;
+			}
+			else
+			{
+				end = xacc >> 3;
+				xacc -= xstep;
+				start = xacc >> 3;
+			}
+			const int span = end - start;
+			if (span <= 0 || (span < 8 && start < 0))
+				continue;
+			const u32 row = BIT(attr, 12) ? 7 - (source_y & 7) : (source_y & 7);
+			const u32 bank = zoom ? ((size & 0x3000) << 3) : 0;
+			const u32 address = (bank | ((attr & 0x7ff) << 4) | (row << 1)) & 0xffff;
+			const u32 pixels = (u32(mdp_vram_word(address)) << 16) | mdp_vram_word(address + 1);
+			const u16 palette = ((attr >> 9) & 0x30) | ((zoom && BIT(size, 14)) ? 0x100 : 0);
+			const u16 priority = BIT(attr, 15) ? 0x80 : 0x40;
+			for (int out = 0; out < span; ++out)
+			{
+				const int x = start + out;
+				if (x < 0 || x >= viewport)
+					continue;
+				int sx = span == 8 ? out : shrink_map[span][out];
+				if (BIT(attr, 11))
+					sx = 7 - sx;
+				const u8 pixel = (pixels >> ((7 - sx) * 4)) & 15;
+				if (pixel)
+					m_sprite_renderline[x + 128] = pixel | palette | priority;
+			}
+		}
+		columns = 4;
+	}
+}
+
+// Run once per native refresh. Keep the last two emitter snapshots and play
+// their movement over the measured update interval, at two presentation times.
+// No CPU cycles, timers, object fields or collision data are modified.
+void sega315_5313_device::sh2_markvi_begin_frame()
+{
+    m_markvi_smooth_valid = false;
+    if (!sh_mdp_video::hz120 || !m_markvi_ready[2]) {
+        m_markvi_history_valid = false;
+        m_markvi_phases[0].clear(); m_markvi_phases[1].clear();
+        return;
+    }
+    if (!m_markvi_history_valid) {
+        std::copy_n(m_markvi_ram[2], 0x10000, m_markvi_history[0]);
+        std::copy_n(m_markvi_ram[2], 0x10000, m_markvi_history[1]);
+        m_markvi_age = 0; m_markvi_span = 1;
+        m_markvi_history_valid = true;
+    } else {
+        ++m_markvi_age;
+        if (std::memcmp(m_markvi_history[1], m_markvi_ram[2], sizeof(m_markvi_history[1]))) {
+            std::copy_n(m_markvi_history[1], 0x10000, m_markvi_history[0]);
+            std::copy_n(m_markvi_ram[2], 0x10000, m_markvi_history[1]);
+            m_markvi_span = std::max(1U, m_markvi_age);
+            m_markvi_age = 0;
+        }
+    }
+    m_markvi_smooth_valid = true;
+    std::vector<sh2_markvi::sprite> previous;
+    auto read = [this](u32 a) -> u16 {
+        return a >= 0xfe0000 ? m_markvi_history[0][(a - 0xfe0000) >> 1] :
+            (a < 0x400000 ? m_space68k->read_word(a) : 0);
+    };
+    if (!sh2_markvi::build(read, previous)) previous.clear();
+    for (unsigned phase = 0; phase < 2; ++phase)
+        m_markvi_phases[phase] = sh2_markvi::interpolate(previous, m_markvi_sprites,
+            std::min(m_markvi_age, m_markvi_span) * 2 + phase + 1, m_markvi_span * 2);
+}
+
+bool sega315_5313_device::mdp_render_markvi_spriteline(int scanline)
+{
+	if (!m_sh2_text_compat || !m_markvi_ready[2] || !sh_mdp_video::markvi.load(std::memory_order_relaxed))
+		return false;
+	std::fill_n(m_sprite_renderline.get(), 1024, 0);
+	const int viewport = (m_regs[12] & 0x81) == 0x81 ? 320 : 256;
+	const bool zoom = BIT(m_regs[36], 7);
+	static constexpr u8 shrink_map[8][8] = {
+		{ 0, 0, 0, 0, 0, 0, 0, 0 },
+		{ 4, 0, 0, 0, 0, 0, 0, 0 },
+		{ 2, 6, 0, 0, 0, 0, 0, 0 },
+		{ 1, 4, 6, 0, 0, 0, 0, 0 },
+		{ 1, 3, 5, 7, 0, 0, 0, 0 },
+		{ 0, 2, 4, 5, 7, 0, 0, 0 },
+		{ 0, 2, 3, 4, 6, 7, 0, 0 },
+		{ 0, 1, 2, 4, 5, 6, 7, 0 }
+	};
+	for (auto it = m_markvi_sprites.rbegin(); it != m_markvi_sprites.rend(); ++it)
+	{
+		const u16 size = it->size;
+		const u16 xword = it->x;
+		const int height = ((size >> 8) & 3) + 1;
+		const int width = ((size >> 10) & 3) + 1;
+		const u32 ystep = zoom ? ((it->zoom & 0x7fff) >> 6) : 64;
+		const int xstep = zoom ? (std::min<u32>(it->zoom & 0x7fff, 0x1000) >> 6) : 64;
+		const u32 delta = (scanline + 128 - it->y) & 0x3ff;
+		if (delta >= (height * ystep) >> 3)
+			continue;
+		const u32 source_y = zoom ? ((delta * 64) / ystep) : delta;
+		u32 attr = it->attr;
+		const u32 tile_y = BIT(attr, 12) ? height - 1 - (source_y >> 3) : (source_y >> 3);
+		attr += tile_y;
+		const bool reverse = BIT(attr, 11);
+		int xacc = ((xword & 0x1ff) - 128) * 8;
+		if (reverse)
+			xacc += xstep * width;
+		const int cells = width;
+
+		for (int cell = 0; cell < cells; ++cell, attr += height)
+		{
+			int start, end;
+			if (!reverse)
+			{
+				start = xacc >> 3;
+				xacc += xstep;
+				end = xacc >> 3;
+			}
+			else
+			{
+				end = xacc >> 3;
+				xacc -= xstep;
+				start = xacc >> 3;
+			}
+			const int span = end - start;
+			if (span <= 0 || (span < 8 && start < 0))
+				continue;
+			const u32 row = BIT(attr, 12) ? 7 - (source_y & 7) : (source_y & 7);
+			const u32 bank = zoom ? ((size & 0x3000) << 3) : 0;
+			const u32 address = (bank | ((attr & 0x7ff) << 4) | (row << 1)) & 0xffff;
+			const u32 pixels = (u32(mdp_vram_word(address)) << 16) | mdp_vram_word(address + 1);
+			const u16 palette = ((attr >> 9) & 0x30) | ((zoom && BIT(size, 14)) ? 0x100 : 0);
+			const u16 priority = BIT(attr, 15) ? 0x80 : 0x40;
+			for (int out = 0; out < span; ++out)
+			{
+				const int x = start + out;
+				if (x < 0 || x >= viewport)
+					continue;
+				int sx = span == 8 ? out : shrink_map[span][out];
+				if (BIT(attr, 11))
+					sx = 7 - sx;
+				const u8 pixel = (pixels >> ((7 - sx) * 4)) & 15;
+				if (pixel)
+					m_sprite_renderline[x + 128] = pixel | palette | priority;
+			}
+		}
+	}
+	return true;
+}
