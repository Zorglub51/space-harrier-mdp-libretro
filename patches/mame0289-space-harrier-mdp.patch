+u16 sega315_5313_device::mdp_dma_read_word(u32 source)
+{
+	// M2 C0F74 checks unsigned >= E00000 before decoding the address. Even
+	// after a DMA cursor crosses FFFFFF it still selects the 128 KiB RAM,
+	// rather than wrapping onto ROM through the 68000's 24-bit address bus.
