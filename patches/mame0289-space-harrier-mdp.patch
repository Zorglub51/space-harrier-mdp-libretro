+void sega315_5313_device::mdp_persist_spriteline(int scanline)
+{
+	if (!m_mdp_scaler || scanline < 0 || scanline >= 240)
+		return;
+
+	// Marquer toutes les identites de la SAT courante, pas seulement celles qui
+	// croisent cette ligne. Un sprite qui s'est deplace verticalement ne laisse ainsi
+	// aucune trainee sur son ancienne ligne.
+	if (++m_mdp_sprite_generation == 0)
+	{
+		std::fill_n(m_mdp_sprite_seen.get(), 0x80001, 0);
+		m_mdp_sprite_generation = 1;
+	}
+	const u16 base_address = (MEGADRIVE_REG05_SPRITE_ADDR & 0x7f) << 9;
+	int index = 0;
+	for (int count = 0; count < 80; count++)
+	{
+		const u16 size_link = m_internal_sprite_attribute_table[index * 4 + 1];
+		const u16 attr = MEGADRIV_VDP_VRAM((base_address >> 1) + index * 4 + 2);
+		const u16 xword = MEGADRIV_VDP_VRAM((base_address >> 1) + index * 4 + 3);
+		const u32 identity = 1 + (attr & 0x7ff) + (((xword >> 9) & 0x7f) << 11)
+				+ ((size_link & 0x1000) ? 0x40000 : 0);
+		m_mdp_sprite_seen[identity] = m_mdp_sprite_generation;
+		index = size_link & 0x7f;
+		if (!index)
+			break;
+	}
+
+	u8 *const previous = m_mdp_prev_sprite.get() + scanline * 1024;
+	u32 *const previous_identity = m_mdp_prev_sprite_identity.get() + scanline * 1024;
+	for (int x = 0; x < 1024; x++)
+	{
+		const u8 current = m_sprite_renderline[x];
+		const u8 old = previous[x];
+		const u32 old_identity = previous_identity[x];
+		previous[x] = current;
+		previous_identity[x] = m_mdp_sprite_identity[x];
+		if (!current && old && old_identity &&
+				m_mdp_sprite_seen[old_identity] != m_mdp_sprite_generation)
+			m_sprite_renderline[x] = old;
+	}
+}
