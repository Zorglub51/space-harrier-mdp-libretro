+	u8 *const previous = m_mdp_prev_sprite.get() + scanline * 1024;
+	u32 *const previous_identity = m_mdp_prev_sprite_identity.get() + scanline * 1024;
+	for (int x = 0; x < 1024; x++)
+	{
+		const u8 current = m_sprite_renderline[x];
+		const u8 old = previous[x];
+		const u32 old_identity = previous_identity[x];
+		previous[x] = current;
+		previous_identity[x] = m_mdp_sprite_identity[x];
+		if (!current && old && old_identity &&
+				m_mdp_sprite_seen[old_identity] != m_mdp_sprite_generation)
+			m_sprite_renderline[x] = old;
