+	// This vector has its final size here and is never resized afterwards.
+	if (m_speaker)
+		for (u32 channel = 0; channel != m_channels; ++channel)
+		{
+			m_speaker->save_item(m_history[channel], &history::m_v0, "audio_filter_history.v0", channel);
+			m_speaker->save_item(m_history[channel], &history::m_v1, "audio_filter_history.v1", channel);
+			m_speaker->save_item(m_history[channel], &history::m_v2, "audio_filter_history.v2", channel);
+		}
+#endif
 }
 
