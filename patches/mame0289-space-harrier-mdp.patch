+void sega315_5313_device::vdp_mdp_w(offs_t offset, u16 data, u16 mem_mask)
+{
+	// MDP : bit 10 de l'adresse octet (= bit 9 de l'offset mot) => ecriture
+	// CRAM directe sur l'entree 0 (couleur de fond). Space Harrier s'en sert
+	// depuis son handler HBlank pour produire le degrade de ciel ligne par
+	// ligne, sans jamais programmer le port de controle.
+	if (BIT(offset, 9))
+	{
+		// L'appliquer tout de suite ferait dependre la position du changement de
+		// couleur du decoupage en tranches du 68000, qui varie d'une trame a
+		// l'autre : le degrade scintillait. On date donc l'ecriture a la ligne
+		// suivante et on l'applique au rendu de cette ligne (voir
+		// render_videoline_to_videobuffer).
+		int line = screen().vpos() + 1;
+		if (line < 0 || line >= 224)
+			line = 0;                       // ecriture pendant le retour trame
+		m_mdp_bg[line] = data;
+		m_mdp_bg_set[line] = 1;
+		return;
 	}
+
+	vdp_w(offset & 0x0f, data, mem_mask);
 }
 
