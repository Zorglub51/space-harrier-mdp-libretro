+void sega315_5313_device::mdp_scaler_line(int scanline, int plane, u16 base, int first, int last)
+{
+	const u8 control = m_regs[32 + plane];
+	if (!m_mdp_scaler || !BIT(control, 7) || first >= last)
+		return;
+
+	// M2 C1BC0: register 32/33 defines the bank, per-line versus affine
+	// transform and wrap/clamp mode. The visible scanline is used unchanged.
+	const u32 table = (control & 0x1f) << 11;
+	const u32 entry = table + (BIT(control, 5) ? scanline * 8 : 0);
+	const s32 dx = s16(mdp_vram_word(entry));
+	const s32 dy = s16(mdp_vram_word(entry + 1));
+	u32 sx = (u32(mdp_vram_word(entry + 4)) << 16) | mdp_vram_word(entry + 5);
+	u32 sy = (u32(mdp_vram_word(entry + 6)) << 16) | mdp_vram_word(entry + 7);
+	if (!BIT(control, 5))
+	{
+		sx += u32(scanline * s32(s16(mdp_vram_word(entry + 2))) + first * dx);
+		sy += u32(scanline * s32(s16(mdp_vram_word(entry + 3))) + first * dy);
+	}
+	static constexpr unsigned size_shift[4] = {5, 6, 0, 7};
+	const unsigned width_shift = size_shift[m_regs[16] & 3];
+	const int width = 8 << width_shift;
+	const int height = 8 << size_shift[(m_regs[16] >> 4) & 3];
+
+	for (int x = first; x < last; ++x, sx += u32(dx), sy += u32(dy))
+	{
+		int px = s32(sx) >> 12;
+		int py = s32(sy) >> 12;
+		if (BIT(control, 6))
+		{
+			px &= width - 1;
+			py &= height - 1;
+		}
+		else
+		{
+			px = std::clamp(px, 0, width - 1);
+			py = std::clamp(py, 0, height - 1);
+		}
+		const u32 tile_address = (base >> 1) | ((py >> 3) << width_shift) | (px >> 3);
+		const u16 attr = mdp_vram_word(tile_address);
+		const int tx = (px & 7) ^ (BIT(attr, 11) ? 7 : 0);
+		const int ty = (py & 7) ^ (BIT(attr, 12) ? 7 : 0);
+		const u16 pixels = mdp_vram_word(((attr & 0x7ff) << 4) | (ty << 1) | (tx >> 2));
+		const u8 colour = (pixels >> (12 - (tx & 3) * 4)) & 15;
+		const u8 palette = (attr >> 9) & 0x30;
+		if (BIT(attr, 15))
+		{
+			if (colour)
+				m_highpri_renderline[x] = colour | palette | 0x80;
+			else
+				m_highpri_renderline[x] |= 0x80;
+		}
+		else if (colour)
+			m_video_renderline[x] = colour | palette;
+	}
+}
