+// ---------------------------------------------------------------------------
+// Zoomeur materiel MDP : une entree de 16 octets par ligne d'ecran, a 0xD1E000.
+//     +0  pas horizontal, virgule fixe 12 bits (0x1000 = 1.0)
+//     +8  abscisse source de depart, 20.12 signe
+//     +C  ordonnee source, 20.12  (0 = ligne inactive)
+// La source est l'espace pixel du plan A (64x64 tuiles = 512x512), dont les lignes
+// 224+ sont hors de la fenetre visible et servent d'atelier.
+//
+// On ecrit dans m_video_renderline, la couche de fond, et non sur l'image finale :
+// les sprites sont composes apres, donc ils repassent correctement par-dessus. Poser
+// le resultat en fin de rendu faisait passer nuages et montagnes devant les sprites.
+// ---------------------------------------------------------------------------
+// Moyenne de la trame courante et de la precedente. N'a d'effet que sur une machine
+// MDP (m_mdp_scaler resolu), pour ne rien changer aux autres pilotes Mega Drive.
+void sega315_5313_device::mdp_blend_frame(bitmap_rgb32 &bitmap, const rectangle &cliprect)
+{
+	// Instrumentation temporaire : vidage de la table des sprites telle que la voit
+	// reellement le VDP, pour une trame donnee (MDP_SATDUMP=<trame>).
+	if (const char *env = getenv("MDP_SATDUMP"))
+	{
+		const int want = atoi(env);
+		if (int(screen().frame_number()) == want)
+		{
+			FILE *fp = fopen(getenv("MDP_SATOUT") ? getenv("MDP_SATOUT") : "/tmp/sat.txt", "w");
+			if (fp)
+			{
+				const int base = (MEGADRIVE_REG05_SPRITE_ADDR & 0x7f) << 9;
+				fprintf(fp, "trame %d   base SAT = %04X\n", want, base);
+				// CRAM : 64 entrees de 9 bits (BBB GGG RRR)
+				int nz = 0;
+				fprintf(fp, "CRAM :");
+				for (int c = 0; c < 64; c++)
+				{
+					if (c % 16 == 0) fprintf(fp, "\n  %02X:", c);
+					fprintf(fp, " %03X", m_cram[c] & 0xeee);
+					if (m_cram[c] & 0xeee) nz++;
+				}
+				fprintf(fp, "\n  entrees non noires : %d / 64\n", nz);
+				// etat de la VRAM et des tables de noms
+				{
+					int vnz = 0;
+					for (int k = 0; k < 0x8000; k++) if (m_vram[k]) vnz++;
+					const int pa = MEGADRIVE_REG02_PATTERN_ADDR_A << 13;
+					const int pb = (MEGADRIVE_REG04_PATTERN_ADDR_B & 0x7) << 13;
+					fprintf(fp, "  VRAM : %d mots non nuls / 32768\n", vnz);
+                    fprintf(fp, "  plan A @ %04X :", pa);
+					for (int k = 0; k < 12; k++) fprintf(fp, " %04X", m_vram[(pa >> 1) + k]);
+					fprintf(fp, "\n  plan B @ %04X :", pb);
+					for (int k = 0; k < 12; k++) fprintf(fp, " %04X", m_vram[(pb >> 1) + k]);
+					fprintf(fp, "\n  plan B, mots 0x80..0x8B :");
+					for (int k = 0x80; k < 0x8c; k++) fprintf(fp, " %04X", m_vram[(pb >> 1) + k]);
+					fprintf(fp, "\n  motif tuile 0x86 :");
+					for (int k = 0; k < 16; k++) fprintf(fp, " %04X", m_vram[(0x86 * 16) + k]);
+					fprintf(fp, "\n  atelier plan A, lignes de tuiles 28..57 :\n");
+					for (int row = 28; row <= 57; row++)
+					{
+						fprintf(fp, "    %02d:", row);
+						for (int col = 0; col < 16; col++)
+							fprintf(fp, " %04X", m_vram[((pa >> 1) + row * 64 + col) & 0x7fff]);
+						fprintf(fp, "\n");
+					}
+					fprintf(fp, "\n\n");
+				}
+				fprintf(fp, "  # |   Y |   X |  zi | l x h | tuile | pal pri | MDP\n");
+				int i = 0;
+				for (int step = 0; step < 80; step++)
+				{
+					const u16 w0 = m_internal_sprite_attribute_table[(i * 4) + 0];
+					const u16 w1 = m_internal_sprite_attribute_table[(i * 4) + 1];
+					const u16 at = MEGADRIV_VDP_VRAM(((base >> 1) + i * 4) + 0x2);
+					const u16 xw = MEGADRIV_VDP_VRAM(((base >> 1) + i * 4) + 0x3);
+					fprintf(fp, " %2d | %3d | %3d | %3d | %d x %d | %5d |  %d   %d  |  %s\n",
+							i, (w0 & 0x1ff) - 128, (xw & 0x1ff) - 128, (xw >> 9) & 0x7f,
+							((w1 & 0x0c00) >> 10) + 1, ((w1 & 0x0300) >> 8) + 1,
+							at & 0x7ff, (at >> 13) & 3, (at >> 15) & 1,
+							(w1 & 0x1000) ? "oui" : "non");
+					// Combien de mots non nuls dans la source reellement choisie par
+					// l'entree. C'est notamment utile pour distinguer un sprite absent
+					// d'un sprite SAT valide qui pointe sur un bloc VRAM vide.
+					{
+						int nz = 0;
+						const u32 t = at & 0x7ff;
+						const int words = (((w1 & 0x0c00) >> 10) + 1) *
+							(((w1 & 0x0300) >> 8) + 1) * 16;
+						if (w1 & 0x1000)
+						{
+							for (int k = 0; k < words; k++)
+								if (m_mdp_ram[(t * 16 + k) & 0x7fff]) nz++;
+							fprintf(fp, "      -> memoire MDP tuiles %u..%u : %d/%d mots non nuls\n",
+								t, t + words / 16 - 1, nz, words);
+						}
+						else
+						{
+							for (int k = 0; k < words; k++)
+								if (m_vram[((t * 16) + k) & 0x7fff]) nz++;
+							fprintf(fp, "      -> VRAM tuiles %u..%u : %d/%d mots non nuls\n",
+								t, t + words / 16 - 1, nz, words);
+						}
+					}
+					const int link = w1 & 0x7f;
+					if (link == 0) break;
+					i = link;
+				}
+				// Balayage de TOUS les emplacements, pas seulement la chaine : revele
+				// les sprites ecrits puis exclus du chainage.
+				fprintf(fp, "\n--- tous les emplacements dont la taille n'est pas 1x1 ---\n");
+				for (int k = 0; k < 80; k++)
+				{
+					const u16 w0 = m_internal_sprite_attribute_table[(k * 4) + 0];
+					const u16 w1 = m_internal_sprite_attribute_table[(k * 4) + 1];
+					const u16 at = MEGADRIV_VDP_VRAM(((base >> 1) + k * 4) + 0x2);
+					const u16 xw = MEGADRIV_VDP_VRAM(((base >> 1) + k * 4) + 0x3);
+					const int lw = ((w1 & 0x0c00) >> 10) + 1, lh = ((w1 & 0x0300) >> 8) + 1;
+					if (lw == 1 && lh == 1) continue;
+					fprintf(fp, " %2d | Y %4d | X %4d | zi %3d | %d x %d | tuile %5d | lien %2d | MDP %s\n",
+							k, (w0 & 0x1ff) - 128, (xw & 0x1ff) - 128, (xw >> 9) & 0x7f,
+							lw, lh, at & 0x7ff, w1 & 0x7f, (w1 & 0x1000) ? "oui" : "non");
+				}
+				fclose(fp);
+			}
+		}
+	}
+
+	if (!m_mdp_scaler)
+		return;
+
+	const int w = cliprect.width(), h = cliprect.height();
+	if (!m_mdp_prev_frame || m_mdp_prev_w != w || m_mdp_prev_h != h)
+	{
+		m_mdp_prev_frame = std::make_unique<u32[]>(size_t(w) * h);
+		m_mdp_prev_w = w;
+		m_mdp_prev_h = h;
+		std::fill_n(m_mdp_prev_frame.get(), size_t(w) * h, 0);
+	}
+
+	for (int y = 0; y < h; y++)
+	{
+		const int sy = cliprect.min_y + y;
+		u32 *const line = &bitmap.pix(cliprect.min_y + y, cliprect.min_x);
+		u32 *const prev = &m_mdp_prev_frame[size_t(y) * w];
+		const bool blend_bg = sy >= 0 && sy < 512 &&
+			m_mdp_bg_valid[sy] && m_mdp_prev_bg_valid[sy];
+		const u32 cur_bg = blend_bg ? m_mdp_bg_rgb[sy] : 0;
+		const u32 old_bg = blend_bg ? m_mdp_prev_bg_rgb[sy] : 0;
+		for (int x = 0; x < w; x++)
+		{
+			const u32 cur = line[x], old = prev[x];
+			prev[x] = cur;
+
+			// Le jeu peut alterner deux couleurs de fond eloignees (62 niveaux sur le
+			// canal bleu au stage 1). L'ancien seuil RGB laissait donc scintiller ces
+			// lignes. Ne moyenner que les pixels qui etaient le fond aux deux trames
+			// supprime le seuil sans creer de trainee sur les sprites en mouvement.
+			if (blend_bg && cur == cur_bg && old == old_bg)
+			{
+				// Une coupure franche (noir -> decor, changement de stage) n'est pas du
+				// tramage. Le seuil, desormais limite au seul fond, peut etre assez large
+				// pour la paire du stage 1 sans jamais melanger un sprite en mouvement.
+				const int dr = std::abs(int((cur >> 16) & 0xff) - int((old >> 16) & 0xff));
+				const int dg = std::abs(int((cur >>  8) & 0xff) - int((old >>  8) & 0xff));
+				const int db = std::abs(int( cur        & 0xff) - int( old        & 0xff));
+				if (dr <= 96 && dg <= 96 && db <= 96)
+					line[x] = (((cur ^ old) & 0xfefefe) >> 1) + (cur & old);
+			}
+		}
+		if (sy >= 0 && sy < 512)
+		{
+			m_mdp_prev_bg_rgb[sy] = m_mdp_bg_rgb[sy];
+			m_mdp_prev_bg_valid[sy] = m_mdp_bg_valid[sy];
+		}
+	}
+}
