+// Legacy intermediate palette cache. MDP's final RGB output bypasses this
+// approximation and uses the original indexed colormap in mdp_indexed_pen.
+static rgb_t mdp_palette_pen(u16 data)
+{
+	const int mode = (data >> 9) & 3;
+	const int r = (data >> 0) & 7;
+	const int g = (data >> 3) & 7;
+	const int b = (data >> 6) & 7;
+	auto level = [mode](int c)
+	{
+		if (mode == 1) return c * 16;                 // ombre
+		if (mode == 2) return std::min(255, 128 + c * 16); // surbrillance
+		return c * 32;                                // couleur normale
+	};
+	return rgb_t(level(r), level(g), level(b));
+}
+
+// M2's RGB4440 colormap callback at 229E08 replicates each nibble (x17).
+// C1E24 produces 2*c for normal intensity and c for shadow intensity.
+static rgb_t mdp_indexed_pen(u16 cram, bool normal)
+{
+	const unsigned step = normal ? 34 : 17;
+	return rgb_t(((cram >> 1) & 7) * step,
+		((cram >> 5) & 7) * step, ((cram >> 9) & 7) * step);
+}
+
+// Original M2 C2476..C2532. Bit 7 selects normal versus shadow colour;
+// sprite operators 3e/3f toggle or clear it, rather than producing highlight.
+static u8 mdp_composite_pixel(u16 plane, u16 sprite, bool shadow)
+{
+	if (!shadow)
+		return u8(((sprite && sprite >= (plane & 0x8000)) ? sprite : plane) | 0x80);
