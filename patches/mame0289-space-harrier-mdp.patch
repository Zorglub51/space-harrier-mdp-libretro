+// M2's RGB4440 colormap callback at 229E08 replicates each nibble (x17).
+// C1E24 produces 2*c for normal intensity and c for shadow intensity.
+static rgb_t mdp_indexed_pen(u16 cram, bool normal)
+{
+	const unsigned step = normal ? 34 : 17;
