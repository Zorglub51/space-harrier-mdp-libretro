+// M2 C30DC..C31DC: the length is a word count, including zero. The source
+// registers survive; the address and zero length are committed only on success.
+void sega315_5313_device::mdp_dma_transfer()
+{
+	const u32 count = m_regs[19] | (m_regs[20] << 8);
+	u32 source = (m_regs[21] << 1) | (m_regs[22] << 9) | (m_regs[23] << 17);
+	u32 address = m_vdp_address;
+	for (u32 i = 0; i < count; ++i)
+	{
+		const u16 data = mdp_dma_read_word(source);
+		// Native code reads the bus before checking word alignment.
+		if (address & 1)
+		{
+			logerror("Unaligned MDP DMA destination %04x\n", address);
+			return;
+		}
+		if (m_vdp_code == 0x21)
+			vram_w(address >> 1, data);
+		else if (m_vdp_code == 0x23)
+			write_cram_value((address & 0xfe) >> 1, data);
+		else
+			mdp_vsram_write(u16(address), data);
+		source += 2;
+		address = (address + m_regs[15]) & 0xffff;
+	}
+	m_vdp_address = address;
+	m_regs[19] = 0;
+	m_regs[20] = 0;
+}
+
+// Native copies are sequential byte operations, including overlapping regions.
+void sega315_5313_device::mdp_vram_copy()
+{
+	const u32 count = m_regs[19] | (m_regs[20] << 8);
+	u32 source = m_regs[21] | (m_regs[22] << 8);
+	u32 address = m_vdp_address;
+	for (u32 i = 0; i < count; ++i)
+	{
+		const u16 word = m_vram[source >> 1];
+		const u8 data = (source & 1) ? u8(word) : u8(word >> 8);
+		if (address & 1)
+			vram_w(address >> 1, data, 0x00ff);
+		else
+			vram_w(address >> 1, u16(data) << 8, 0xff00);
+		source = (source + 1) & 0xffff;
+		address = (address + m_regs[15]) & 0xffff;
+	}
+	m_vdp_address = address;
+	m_vdp_code = 0xff;
+}
