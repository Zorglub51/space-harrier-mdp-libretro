+		const u32 transform = zoom_base + (xword >> 9) * 8;
+		const u32 ystep = zoom ? ((mdp_vram_word(transform + 3) & 0x7fff) >> 6) : 64;
+		const int xstep = zoom ? (std::min<u32>(mdp_vram_word(transform) & 0x7fff, 0x1000) >> 6) : 64;
+		const u32 delta = (scanline + 128 - mdp_vram_word(sat)) & 0x3ff;
+		const u32 source_y = zoom ? ((delta * 64) / ystep) : delta;
+		u32 attr = mdp_vram_word(sat + 2);
+		const u32 tile_y = BIT(attr, 12) ? height - 1 - (source_y >> 3) : (source_y >> 3);
+		attr += tile_y;
+		const bool reverse = BIT(attr, 11);
+		int xacc = ((xword & 0x1ff) - 128) * 8;
+		if (reverse)
+			xacc += xstep * width;
+		const int cells = std::min(columns, width);
+
+		for (int cell = 0; cell < cells; ++cell, attr += height)
+		{
+			int start, end;
+			if (!reverse)
+			{
+				start = xacc >> 3;
+				xacc += xstep;
+				end = xacc >> 3;
+			}
+			else
+			{
+				end = xacc >> 3;
+				xacc -= xstep;
+				start = xacc >> 3;
+			}
+			const int span = end - start;
+			if (span <= 0 || (span < 8 && start < 0))
+				continue;
+			const u32 row = BIT(attr, 12) ? 7 - (source_y & 7) : (source_y & 7);
+			const u32 bank = zoom ? ((size & 0x3000) << 3) : 0;
+			const u32 address = (bank | ((attr & 0x7ff) << 4) | (row << 1)) & 0xffff;
+			const u32 pixels = (u32(mdp_vram_word(address)) << 16) | mdp_vram_word(address + 1);
+			const u16 palette = ((attr >> 9) & 0x30) | ((zoom && BIT(size, 14)) ? 0x100 : 0);
+			const u16 priority = BIT(attr, 15) ? 0x80 : 0x40;
+			for (int out = 0; out < span; ++out)
+			{
+				const int x = start + out;
+				if (x < 0 || x >= viewport)
+					continue;
+				int sx = span == 8 ? out : shrink_map[span][out];
+				if (BIT(attr, 11))
+					sx = 7 - sx;
+				const u8 pixel = (pixels >> ((7 - sx) * 4)) & 15;
+				if (pixel)
+					m_sprite_renderline[x + 128] = pixel | palette | priority;
+			}
+		}
+		columns = 4;
+	}
+}
