le paquet complet.'}; do { $ra=Pick 'Choisissez RetroArch.exe (Windows x64)' 'RetroArch (retroarch.exe)|retroarch.exe|Applications (*.exe)|*.exe'; if(-not $ra){exit 0}; $valid=$false; try {$valid=(PeMachine $ra) -eq 0x8664 -and [IO.Path]::GetFileName($ra) -ieq 'retroarch.exe'}catch{}; if(-not $valid -and -not (Retry 'Choisissez RetroArch.exe x64, et non une version 32 bits ou ARM64.')){exit 0} } until($valid); do { $rom=Pick 'Choisissez votre ROM originale SH2' 'ROM SH2 originale (*.smp)|*.smp|Tous les fichiers (*.*)|*.*'; if(-not $rom){exit 0}; $valid=(Get-FileHash -LiteralPath $rom -Algorithm SHA1).Hash -ieq '80f576af01d6413c0b92073e2f947b0431f12a74'; if(-not $valid -and -not (Retry 'Ce fichier ne correspond pas a SH2 original. Choisissez jp_jp_Space_Harrier_II.smp non modifie (3670016 octets).')){exit 0} } until($valid); $mode='normal'; $session=Join-Path $root ('session/sh2-'+(Get-Date -Format 'yyyyMMdd-HHmmss')+'-'+$PID+'-'+$mode); foreach($name in @('saves','states','screenshots','system','logs','config','playlists','remaps')){[void][IO.Directory]::CreateDirectory((Join-Path $session $name))}; $cfg=Join-Path $session 'retroarch.cfg'; $options=Join-Path $session 'core-options.cfg'; $log=Join-Path $session 'logs/retroarch.log'; $raDir=Split-Path -LiteralPath $ra; $settings=[ordered]@{ config_save_on_exit='false'; menu_driver='rgui'; video_fullscreen='false'; video_windowed_fullscreen='false'; video_scale='3'; video_vsync='true'; audio_sync='true'; video_shader_enable='false'; video_smooth='false'; pause_nonactive='true'; pause_on_disconnect='false'; rewind_enable='false'; run_ahead_enabled='false'; preemptive_frames_enable='false'; savestate_auto_load='false'; savestate_auto_save='false'; auto_overrides_enable='false'; auto_remaps_enable='false'; auto_shaders_enable='false'; history_list_enable='false'; content_runtime_log='false'; content_runtime_log_aggregate='false'; core_info_cache_enable='false'; global_core_options='true'; input_autodetect_enable='true'; input_player1_joypad_index='0'; input_libretro_device_p1='1'; input_player1_up='up'; input_player1_down='down'; input_player1_left='left'; input_player1_right='right'; input_player1_b='z'; input_player1_a='x'; input_player1_start='enter'; input_menu_toggle='f1'; input_pause_toggle='p'; input_screenshot='f8'; input_exit_emulator='escape'; quit_press_twice='false'; core_options_path=$options; libretro_info_path=$root; }; foreach($pair in @(@('savefile_directory','saves'),@('savestate_directory','states'),@('screenshot_directory','screenshots'),@('system_directory','system'),@('log_dir','logs'),@('rgui_config_directory','config'),@('playlist_directory','playlists'),@('input_remapping_directory','remaps'))){$settings[$pair[0]]=Join-Path $session $pair[1]}; foreach($pair in @(@('assets_directory','assets'),@('joypad_autoconfig_dir','autoconfig'))){$path=Join-Path $raDir $pair[1]; if(Test-Path -LiteralPath $path -PathType Container){$settings[$pair[0]]=$path}}; WriteConfig $cfg $settings; WriteConfig $options ([ordered]@{mame_cheats_enable='disabled';mame_auto_save='disabled';mame_read_config='disabled';mame_write_config='disabled';mame_mame_paths_enable='disabled';mame_mame_4way_enable='disabled';mame_throttle='disabled';mame_cpu_overclock='default';mame_thread_mode='enabled'}); $record=[ordered]@{mode=$mode;core_sha256=$coreHash;rom_sha1='80f576af01d6413c0b92073e2f947b0431f12a74';retroarch=$ra;retroarch_file_version=[Diagnostics.FileVersionInfo]::GetVersionInfo($ra).FileVersion}; [IO.File]::WriteAllText((Join-Path $session 'session.json'),($record|ConvertTo-Json),[Text.UTF8Encoding]::new($false)); Write-Host ('SH2 - mode '+$mode); Write-Host 'Entree : demarrer | Fleches : bouger | Z : tirer'; Write-Host 'P : pause | F8 : capture | F1 : menu | Echap : quitter'; Write-Host ('Journal : '+$log); Push-Location -LiteralPath $session; try { & $ra --config $cfg --verbose --log-file $log -L $core $rom | Out-Host; $result=$LASTEXITCODE } finally {Pop-Location}; if($result -ne 0){throw ('RetroArch a quitte avec le code '+$result+'. Consultez '+$log)}; Write-Host ('Session conservee : '+$session); exit 0 } catch {Write-Host ('Erreur : '+$_.Exception.Message) -ForegroundColor Red; Write-Host 'Consultez LISEZ_MOI_SH2_WINDOWS.txt puis relancez le lanceur.'; exit 1}"
